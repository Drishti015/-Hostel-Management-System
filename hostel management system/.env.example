# ==============================================================================
# HostelEase HMS — Environment Configuration Template (.env.example)
# DO NOT ADD REAL PASSWORDS OR PRODUCTION SECRETS TO THIS FILE
# For local development: copy this file to .env and adjust variables as needed.
# For Vercel production: configure these keys in Vercel Project Settings > Environment Variables.
# ==============================================================================

# Core Application Security
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
FLASK_ENV=development
FLASK_DEBUG=1

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# 1. Local Development (Default):
# Leave DATABASE_URL empty to automatically use local SQLite (instance/hostel.sqlite3)
# Or configure local MySQL below:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=hostel_db

# 2. Production Deployment (Supabase PostgreSQL / Vercel):
# Set DATABASE_URL in your hosting platform (Vercel) Environment Variables.
# For Supabase on Serverless (Vercel), using the Transaction Pooler (port 6543) is recommended:
# Format: postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Or Direct / Session Connection (port 5432):
# Format: postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=


