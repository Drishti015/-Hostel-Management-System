# Application Configuration
SECRET_KEY=aktu-hms-secret-key-super-secure-2026
FLASK_ENV=development
FLASK_DEBUG=1

# MySQL Database Configuration
# Default local MySQL port is 3306
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
